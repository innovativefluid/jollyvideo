{
  "name": "jollyvideo",
  "version": "0.3.1",
  "description": "Watch YouTube videos and livestreams together in Sharkord voice channels",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "bun build.ts",
    "check": "tsc --noEmit && bun scripts/check-classes.ts",
    "preview": "bun scripts/preview.ts",
    "sharkord": "bun scripts/sharkord.ts",
    "test": "bun test tests/unit tests/server && bun test --preload ./tests/helpers/dom.ts tests/client",
    "test:e2e": "bash e2e/run.sh",
    "test:media": "bun test tests/media",
    "test:network": "bun test tests/network",
    "test:package": "bun test tests/package"
  },
  "dependencies": {
    "lucide-react": "0.544.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.10",
    "@sharkord/plugin-sdk": "file:vendor/sharkord/plugin-sdk",
    "@sharkord/shared": "file:vendor/sharkord/shared",
    "@tailwindcss/cli": "4.1.13",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.3.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "mediasoup": "3.19.19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.1.13",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "zod": "4.3.6"
  },
  "trustedDependencies": [
    "mediasoup"
  ]
}
